<Window x:Class="MailTrim.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MailTrim" Width="1320" Height="850" MinWidth="1000" MinHeight="560" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
   <Grid Margin="12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
     <Border Background="#3366EB" CornerRadius="7" Width="30" Height="30"><TextBlock Text="M" FontWeight="Bold" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>

    </StackPanel>
    <ListBox Grid.Column="1" x:Name="Profiles" SelectionChanged="Profiles_SelectionChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Вкладки ящиков">
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" ToolTip="{Binding StatusText}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="145"/><TextBlock Text="{Binding UnreadBadge}" FontWeight="Bold" Margin="6,0,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
       <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Padding" Value="10,7"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Tab" CornerRadius="6,6,0,0" Background="{DynamicResource Surface}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Line}"/></Trigger>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#3366EB"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
         <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#3366EB"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style>
     </ListBox.ItemContainerStyle>
    </ListBox>
    <Button Grid.Column="3" Content="+" Width="30" Height="30" Padding="0" ToolTip="Добавить ящик" Click="Add_Click"/>
    <Button Grid.Column="2" x:Name="ProfileActionsButton" Content="⋯" Width="34" Height="32" Padding="0" FontSize="20" VerticalAlignment="Center" ToolTip="Управление ящиками" AutomationProperties.Name="Управление ящиками" Click="ProfileActions_Click">
     <Button.ContextMenu>
      <ContextMenu Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}">
       <MenuItem Header="Добавить ящик…" Click="Add_Click"/>
       <Separator/>
       <MenuItem x:Name="RenameMenu" Header="Переименовать текущий ящик…" Click="Rename_Click"/>
       <MenuItem x:Name="ClearMenu" Header="Очистить сессию текущего ящика…" Click="Clear_Click"/>
       <MenuItem x:Name="RemoveMenu" Header="Удалить текущий профиль…" Click="Remove_Click"/>
      </ContextMenu>
     </Button.ContextMenu>
    </Button>
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="ReaderButton" Content="Только важное" Height="32" Padding="8,0" Click="Reader_Click"/>
     <Button x:Name="BackButton" Content="←" Width="34" Height="32" Padding="0" ToolTip="Назад (Alt+Left)" AutomationProperties.Name="Назад" Click="Back_Click"/>
     <Button x:Name="ReloadButton" Content="↻" Width="34" Height="32" Padding="0" FontSize="18" ToolTip="Обновить (F5)" AutomationProperties.Name="Обновить" Click="Reload_Click"/>
     <Button x:Name="HomeButton" Content="Входящие" Height="32" Padding="10,0" Click="Home_Click"/>
     <Button x:Name="PauseButton" Content="Фильтры: вкл" Height="32" Padding="10,0" ToolTip="Приостановить фильтры" Click="Pause_Click"/>
     <Button Content="⚙" Width="34" Height="32" Padding="0" FontSize="18" ToolTip="Настройки" AutomationProperties.Name="Настройки" Click="Settings_Click"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <StackPanel x:Name="EmptyLabel" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Добавьте ящик, чтобы открыть почту" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
    <Button Content="+ Добавить ящик" Click="Add_Click" HorizontalAlignment="Center"/>
   </StackPanel>
   <Grid x:Name="BrowserHost"/>
   <Grid x:Name="ReaderHost" Visibility="Collapsed"/>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
   <DockPanel Margin="12,0">
    <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/>
    <TextBlock x:Name="ConnectionStatus" DockPanel.Dock="Right" FontSize="11" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
    <TextBlock x:Name="Status" Text="Готово" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>



