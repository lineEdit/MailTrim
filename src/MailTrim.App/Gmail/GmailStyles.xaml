<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:MailTrim.App">
  <app:GmailDisplayConverter x:Key="GmailSender" Kind="Sender"/>
  <app:GmailDisplayConverter x:Key="GmailInitial" Kind="Initial"/>
  <app:GmailDisplayConverter x:Key="GmailDate" Kind="Date"/>
  <app:GmailDisplayConverter x:Key="GmailPreview" Kind="Preview"/>
  <app:GmailDisplayConverter x:Key="GmailFolderName" Kind="FolderName"/>
  <app:GmailDisplayConverter x:Key="GmailFolderIcon" Kind="FolderIcon"/>
  <BooleanToVisibilityConverter x:Key="GmailVisibility"/>

  <Style x:Key="GmailSideButton" TargetType="Button" BasedOn="{StaticResource NativeToolbarButton}">
    <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="4,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <ContentPresenter x:Name="Caption" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ServiceSelected}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
        <DataTrigger Binding="{Binding FoldersCollapsed, RelativeSource={RelativeSource AncestorType={x:Type app:GmailPane}}}" Value="True"><Setter TargetName="Caption" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <DataTemplate x:Key="GmailFolderTemplate">
    <Grid Height="24" ToolTip="{Binding Name}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Converter={StaticResource GmailFolderIcon}}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <TextBlock x:Name="FolderCaption" Grid.Column="1" Text="{Binding Converter={StaticResource GmailFolderName}}" Foreground="{DynamicResource Ink}" FontSize="13" Margin="9,0,2,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding FoldersCollapsed, RelativeSource={RelativeSource AncestorType={x:Type app:GmailPane}}}" Value="True"><Setter TargetName="FolderCaption" Property="Visibility" Value="Collapsed"/></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="GmailFolderGroupTemplate">
    <TextBlock Text="{Binding Name}" Margin="13,15,4,7" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <DataTrigger Binding="{Binding FoldersCollapsed, RelativeSource={RelativeSource AncestorType={x:Type app:GmailPane}}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
  </DataTemplate>
  <Style x:Key="GmailFolderItem" TargetType="ListBoxItem" BasedOn="{StaticResource NativeListItem}">
    <Setter Property="Padding" Value="3,5"/><Setter Property="Margin" Value="4,1"/><Setter Property="MinHeight" Value="36"/>
  </Style>

  <Style x:Key="GmailMessageItem" TargetType="ListBoxItem" BasedOn="{StaticResource NativeListItem}">
    <Setter Property="Padding" Value="9,12"/><Setter Property="Margin" Value="3,1"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="8">
        <ContentPresenter HorizontalAlignment="Stretch"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ServiceSelected}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="GmailMessageTemplate">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Ellipse x:Name="UnreadDot" Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Visibility="{Binding Unread,Converter={StaticResource GmailVisibility}}"/>
      <Border Grid.Column="1" Grid.RowSpan="3" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Surface}" VerticalAlignment="Top" Margin="2,0,6,0">
        <TextBlock Text="{Binding From,Converter={StaticResource GmailInitial}}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="SenderName" Grid.Column="2" Text="{Binding From,Converter={StaticResource GmailSender}}" ToolTip="{Binding From}" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,0,5,3">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="CompactDate" Grid.Column="3" Text="{Binding ReceivedAt,Converter={StaticResource GmailDate}}" ToolTip="{Binding ReceivedAt}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="5,1,0,0"/>
      <TextBlock x:Name="Subject" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding Subject}" ToolTip="{Binding Subject}" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,0,0,4">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="Preview" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" Text="{Binding Preview,Converter={StaticResource GmailPreview}}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" FontSize="11"/>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
